# Konfigurasi Supabase (Opsional untuk Mode Lokal/Sandbox — Wajib untuk Mode Cloud Multi-Device)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Daftar Origin Resmi untuk Proteksi API Mutasi (dipisahkan koma)
ALLOWED_ORIGINS=http://localhost:3000

# Kunci rahasia server untuk penandatanganan token masa aktif langganan offline (HMAC-SHA256)
# JANGAN PERNAH mengekspos kunci ini dengan prefix NEXT_PUBLIC_
SUBSCRIPTION_SIGNING_SECRET=replace-with-32-byte-random-hex-secret
